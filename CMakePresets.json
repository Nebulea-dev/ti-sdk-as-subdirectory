{
    "version": 3,
    "configurePresets": [
        {
            "name": "defaults",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            }
        },
        {
            "name": "TI",
            "hidden": true,
            "inherits": "defaults",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;MinSizeRel",
                "CN_BUILD_TESTS": "Off",
                "EMIL_GENERATE_PACKAGE_CONFIG": false,
                "TI_MIN_CMAKE_VERSION": "3.21.3",
                "CMAKE_MESSAGE_LOG_LEVEL": "VERBOSE",
                "EMIL_INCLUDE_SEGGER_RTT": "On"
            }
        },
        {
            "name": "cc2340r5-ticlang",
            "inherits": "TI",
            "toolchainFile": "${sourceDir}/ticlang.cmake",
            "environment": {
                "TICLANG_ARMCOMPILER": "/opt/ti-cgt-armllvm_3.2.2.LTS/"
            },
            "cacheVariables": {
                "TICLANG_ARMCOMPILER": "/opt/ti-cgt-armllvm_3.2.2.LTS/"
            }
        },
        {
            "name": "cc2340r5-gcc",
            "inherits": "TI",
            "toolchainFile": "${sourceDir}/gcc.cmake",
            "environment": {
                "GCC_ARMCOMPILER" : "/opt/gcc-arm-none-eabi/"
            },
            "cacheVariables": {
                "GCC_ARMCOMPILER" : "/opt/gcc-arm-none-eabi/"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc2340r5-ticlang-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "cc2340r5-ticlang"
        },
        {
            "name": "cc2340r5-ticlang-MinSizeRel",
            "configuration": "MinSizeRel",
            "configurePreset": "cc2340r5-ticlang"
        },
        {
            "name": "cc2340r5-ticlang-Debug",
            "configuration": "Debug",
            "configurePreset": "cc2340r5-ticlang"
        },
        {
            "name": "cc2340r5-gcc-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "cc2340r5-gcc"
        },
        {
            "name": "cc2340r5-gcc-MinSizeRel",
            "configuration": "MinSizeRel",
            "configurePreset": "cc2340r5-gcc"
        },
        {
            "name": "cc2340r5-gcc-Debug",
            "configuration": "Debug",
            "configurePreset": "cc2340r5-gcc"
        }
    ]
}
